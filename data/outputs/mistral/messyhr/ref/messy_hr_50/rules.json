  "parsing_rules": {
    "Age": {
      "text_to_number": {
        "mappings": {
          "thirty": 30,
          "thirty five": 35,
          "twenty five": 25,
          "fifty": 50
        },
        "default_value": null
      }
    },
    "Salary": {
      "text_to_number": {
        "mappings": {
          "SIXTY THOUSAND": 60000,
          "NAN": null
        },
        "regex_pattern": "^\\d+$|^\\d{1,3}(?:\\,\\d{3})*$",
        "default_value": null
      }
    },
    "Joining Date": {
      "date_formats": [
        "MM/dd/yyyy",
        "dd-MM-yyyy",
        "yyyy.MM.dd",
        "MM-dd-yyyy"
      ],
      "default_value": null
    }
  },
  "missing_value_policy": {
    "empty_string": "",
    "null_value": "NULL",
    "unparseable_value": "NULL",
    "invalid_value": "NULL"
