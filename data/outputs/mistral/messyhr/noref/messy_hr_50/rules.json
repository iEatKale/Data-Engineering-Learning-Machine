  "value_normalisation": {
    "gender": {
      "allowed_values": [
        "Male",
        "Female",
        "Other"
      ],
      "standard_values": {
        "F": "Female",
        "M": "Male",
        "m": "Male",
        "f": "Female"
      }
    },
    "department": {
      "allowed_values": [
        "HR",
        "Finance",
        "Marketing",
