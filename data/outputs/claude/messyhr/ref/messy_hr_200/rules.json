      "type": "date",
      "input_formats": [
        "M/DD/YYYY",
        "DD-MMM-YY",
        "YYYY.MM.DD"
      ],
      "output_format": "DD/MM/YYYY"
    }
  },
  "missing_value_policy": {
    "numeric_fields": "NULL",
    "text_fields": "",
    "description": "Missing numeric values represented as NULL, missing text fields as empty string"
