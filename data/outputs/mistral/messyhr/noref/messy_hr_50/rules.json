  "parsing_rules": {
    "age": {
      "type": "numeric",
      "conversion": {
        "rule": "replace('thirty', 30)",
        "fallback": "NA"
      }
    },
    "salary": {
      "type": "numeric",
      "conversion": {
        "rule": "replace('SIXTY THOUSAND', 60000)",
        "fallback": "NA"
      },
      "unit": "USD"
    },
    "joining_date": {
      "type": "date",
      "conversion": {
        "rule": "parse_date_with_format([format1, format2, format3])",
        "formats": [
          "MMM-d-yy",
          "yyyy.MM.dd",
          "MM/dd/yyyy",
          "dd/MM/yyyy"
        ],
        "fallback": "NA"
      }
    },
    "performance_score": {
      "type": "categorical",
      "conversion": {
        "rule": "map_to_standard_value(standard_values)"
      }
    },
    "employee_statement": {
      "type": "text",
      "conversion": {
        "rule": "trim_and_lowercase",
        "fallback": "NA"
      }
    }
  },
  "missing_value_policy": {
    "strategy": "impute_with_placeholder",
    "placeholder": {
      "age": "NA",
      "salary": "NA",
      "joining_date": "NA",
      "performance_score": "NA",
      "employee_statement": "NA",
      "gender": "Unknown",
